# ====================================================
# CAREERBRIDGEAI - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and populate with your credentials
# DO NOT COMMIT YOUR REAL .env TO GIT!
# ====================================================

PORT=5000

# MongoDB Atlas Database URI (Replace with your secure cluster credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerbridgeai?retryWrites=true&w=majority

# Strong Random Secret Key for JWT token signing
JWT_SECRET=your_super_strong_random_jwt_secret_change_in_production

# Frontend Client Origin for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# Email Service (Gmail SMTP for real OTP delivery)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_google_app_password
EMAIL_FROM="CareerBridgeAI Support <support@careerbridgeai.com>"

# Twilio Programmable SMS Gateway (For Real Mobile OTP delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Fast2SMS Alternative (Optional)
FAST2SMS_API_KEY=

# Google Gemini LLM API Key (For AI Career Mentor and Fallback Evaluation)
AI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID (For client-side & server-side verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
